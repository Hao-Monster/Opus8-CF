{
  "name": "@opus8-cf/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --external:cloudflare:sockets --loader:.yaml=text --outfile=dist/index.js",
    "test:cors": "node test/cors-test.mjs",
    "test:signature": "node test/signature-test.mjs",
    "test:integration-auth": "node test/integration-auth-test.mjs",
    "test:automation-auth": "node test/automation-auth-test.mjs",
    "test:admin-login-rate-limit": "node test/admin-login-rate-limit-test.mjs",
    "test:webmaster-benefit": "node test/webmaster-benefit-test.mjs",
    "test:deploy-preflight": "node test/deployment-preflight-test.mjs",
    "test:key-rotation": "node test/key-rotation-test.mjs",
    "test:d1-backup": "node test/d1-backup-crypto-test.mjs && node test/d1-export-data-test.mjs",
    "test:subscription-rate-limit": "node test/subscription-rate-limit-test.mjs",
    "test:subscription": "node test/subscription-renderer-test.mjs",
    "test:subscription-rules": "node test/subscription-rules-test.mjs",
    "test:optimized-ip": "node test/optimized-ip-selection-test.mjs",
    "test:device-credentials": "node test/device-credentials-test.mjs",
    "test:usage-aggregation": "node test/usage-aggregation-test.mjs",
    "test:operations-hardening": "node test/operations-hardening-test.mjs",
    "test:node-matrix": "node test/node-deploy-matrix-test.mjs",
    "test:data-maintenance": "node test/data-maintenance-test.mjs",
    "test:compliance": "node test/compliance-test.mjs",
    "test:compliance:local": "pnpm build && node test/compliance-runtime-local.mjs",
    "test:resource-audit": "node test/resource-audit-test.mjs",
    "test:transport-path": "node test/transport-path-test.mjs",
    "test:schema-migration": "node test/schema-transport-migration-test.mjs",
    "test:client-compatibility": "node test/client-compatibility-test.mjs",
    "test:supply-chain": "node test/supply-chain-test.mjs",
    "test:integration": "node test/integration.mjs",
    "test:integration:local": "pnpm build && node test/integration-local.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@opus8-cf/shared": "workspace:*",
    "yaml": "2.9.0"
  }
}
